# ==========================================
# Root .gitignore for ShopFlow
# ==========================================

# Compiled & Build Outputs
target/
**/target/
build/
**/build/
dist/
**/dist/
.next/
**/.next/
out/
**/out/

# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment Variables & Local Secrets
.env.local
.env.*.local
**/.env.local
**/.env.*.local

# IDE & Editor Configurations
.idea/
**/.idea/
*.iml
*.iws
*.ipr
.vscode/
**/.vscode/
.classpath
.project
.settings/
.factorypath
.apt_generated/

# Logs & Diagnostics
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backend/error.json
backend/backend.log

# Testing & Coverage
coverage/
**/coverage/
*.lcov
.nyc_output/

# OS Specific Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
