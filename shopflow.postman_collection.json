{
  "info": {
    "_postman_id": "shopflow-2026-collection",
    "name": "ShopFlow API Collection",
    "description": "Collection Postman complète pour l'API ShopFlow — Spring Boot 3 + JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register — Client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prenom\": \"Alice\",\n  \"nom\": \"Martin\",\n  \"email\": \"alice@shopflow.com\",\n  \"password\": \"alice123\",\n  \"role\": \"CUSTOMER\"\n}"
            }
          }
        },
        {
          "name": "Register — Vendeur",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prenom\": \"Bob\",\n  \"nom\": \"Dupont\",\n  \"email\": \"bob@shopflow.com\",\n  \"password\": \"bob123\",\n  \"role\": \"SELLER\",\n  \"shopName\": \"Boutique Bob\",\n  \"shopDescription\": \"Les meilleurs produits\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "pm.test('Login OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@shopflow.com\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "🛍️ Produits",
      "item": [
        {
          "name": "GET — Liste paginée avec filtres",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?page=0&size=12&sort=prix,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "12" },
                { "key": "sort", "value": "prix,asc" },
                { "key": "category", "value": "", "disabled": true },
                { "key": "minPrice", "value": "", "disabled": true },
                { "key": "maxPrice", "value": "", "disabled": true },
                { "key": "sellerId", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "GET — Détail produit (id=1)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/1"
          }
        },
        {
          "name": "GET — Recherche full-text",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/search?q=laptop"
          }
        },
        {
          "name": "GET — Top ventes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/top-selling"
          }
        },
        {
          "name": "POST — Créer produit (SELLER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Laptop Pro 2026\",\n  \"description\": \"Ordinateur haute performance avec 32 Go RAM\",\n  \"prix\": 1499.99,\n  \"prixPromo\": 1299.99,\n  \"stock\": 20,\n  \"actif\": true,\n  \"categoryNames\": [\"Informatique\"],\n  \"images\": [\"https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=800\"]\n}"
            }
          }
        },
        {
          "name": "PUT — Modifier produit (id=1)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/products/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Laptop Pro 2026 - Édition Limitée\",\n  \"prix\": 1599.99,\n  \"stock\": 15\n}"
            }
          }
        },
        {
          "name": "DELETE — Désactiver produit (id=1)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/products/1"
          }
        }
      ]
